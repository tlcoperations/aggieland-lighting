{#- Ads & analytics. Everything here is OFF until an ID is filled in under "tracking" in src/_data/site.json. -#}
{%- set tr = site.tracking %}
{%- if tr.googleSiteVerification %}<meta name="google-site-verification" content="{{ tr.googleSiteVerification }}">{% endif %}
{%- if tr.metaDomainVerification %}<meta name="facebook-domain-verification" content="{{ tr.metaDomainVerification }}">{% endif %}
<script>
  window.AGL_TRACK = {
    ga4: "{{ tr.ga4Id }}",
    ads: "{{ tr.googleAdsId }}",
    conversions: {{ tr.googleAdsConversions | dump | safe }},
    pixel: "{{ tr.metaPixelId }}",
    shopHost: "{{ site.shopUrl | replace('https://', '') | replace('http://', '') }}"
  };
</script>
{%- if tr.ga4Id or tr.googleAdsId %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ tr.ga4Id or tr.googleAdsId }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  {% if tr.ga4Id %}gtag('config', '{{ tr.ga4Id }}');{% endif %}
  {% if tr.googleAdsId %}gtag('config', '{{ tr.googleAdsId }}');{% endif %}
</script>
{%- endif %}
{%- if tr.metaPixelId %}
<script>
  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
  n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
  document,'script','https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '{{ tr.metaPixelId }}');
  fbq('track', 'PageView');
</script>
{%- endif %}
