{#- BOOK — consultation request. Shows a form when site.json has consultFormEndpoint, otherwise call/visit buttons.
    title, text, id.
    The form POSTs to the endpoint (FormSubmit.co, Formspree, Basin, Getform…) and asks it to redirect to /thanks/.
    Hidden fields: _next/_redirect (thank-you URL; rewritten to the current origin by track.js so Render previews work),
    _honey/_gotcha (spam traps), utm_*/gclid/fbclid (added by track.js when the visit has them). -#}
<section class="section bg-{{ block.bg or 'plain' }}" id="{{ block.id or 'book' }}">
  <div class="container narrow">
    <h2>{{ block.title or "Book it." }}</h2>
    {% if block.text %}<div class="text-lg">{{ block.text | md | safe }}</div>{% endif %}
    {%- if site.consultFormEndpoint %}
    {%- set thanksUrl = "/thanks/" | absoluteUrl(site.url) %}
    <form class="form consult-form" id="consult-form" action="{{ site.consultFormEndpoint }}" method="POST" data-thanks-path="/thanks/">
      <p class="form-note" id="consult-form-note">Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required. Prefer to talk? Call <a href="tel:{{ site.phoneE164 }}">{{ site.phone }}</a>.</p>

      <div class="form-row">
        <label for="cf-name"><span>Name <span aria-hidden="true">*</span></span>
          <input id="cf-name" name="name" autocomplete="name" required>
        </label>
        <label for="cf-phone"><span>Phone</span>
          <input id="cf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel">
        </label>
      </div>

      <label for="cf-email"><span>Email <span aria-hidden="true">*</span></span>
        <input id="cf-email" name="email" type="email" autocomplete="email" required>
      </label>

      <div class="form-row">
        <label for="cf-project"><span>What are you working on?</span>
          <select id="cf-project" name="project_type">
            <option value="New build">New build</option>
            <option value="Remodel">Remodel</option>
            <option value="Just browsing">Just browsing</option>
          </select>
        </label>
        <label for="cf-timeline"><span>Timeline</span>
          <select id="cf-timeline" name="timeline">
            <option value="Not sure yet">Not sure yet</option>
            <option value="As soon as possible">As soon as possible</option>
            <option value="Within 3 months">Within 3 months</option>
            <option value="3 to 6 months">3 to 6 months</option>
            <option value="6+ months">6+ months</option>
          </select>
        </label>
      </div>

      <label for="cf-product" class="form-product" hidden><span>Fixture you're interested in</span>
        <input id="cf-product" name="product" maxlength="200" autocomplete="off" disabled>
      </label>
      <input type="hidden" name="product_id" value="" disabled>
      <input type="hidden" name="source" value="" disabled>

      <label for="cf-message"><span>Anything we should know? (optional)</span>
        <textarea id="cf-message" name="message" rows="4"></textarea>
      </label>

      <div class="form-trap" aria-hidden="true">
        <label><span>Leave this field empty</span> <input name="_honey" type="text" tabindex="-1" autocomplete="off"></label>
        <label><span>Leave this field empty</span> <input name="_gotcha" type="text" tabindex="-1" autocomplete="off"></label>
      </div>
      <input type="hidden" name="_next" value="{{ thanksUrl }}">
      <input type="hidden" name="_redirect" value="{{ thanksUrl }}">
      <input type="hidden" name="_subject" value="New consultation request — {{ site.shortName }}">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="source_page" value="">

      <button class="btn btn-primary" type="submit">Request a consultation</button>
    </form>
    {%- else %}
    <div class="cta-row">
      <a class="btn btn-primary" href="tel:{{ site.phoneE164 }}">Call {{ site.phone }}</a>
      <a class="btn btn-outline" href="/visit/">Directions &amp; hours</a>
    </div>
    {%- endif %}
  </div>
</section>
