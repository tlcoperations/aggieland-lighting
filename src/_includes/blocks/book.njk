{#- BOOK — consultation request. Shows a form when site.json has consultFormEndpoint, otherwise call/visit buttons.
    title, text, id -#}
<section class="section bg-{{ block.bg or 'plain' }}" id="{{ block.id or 'book' }}">
  <div class="container narrow">
    <h2>{{ block.title or "Book it." }}</h2>
    {%- if site.consultFormEndpoint %}
    <p>Fill this out and somebody will get back to you within a business day. Or call <a href="tel:{{ site.phoneE164 }}">{{ site.phone }}</a>.</p>
    <form class="form" action="{{ site.consultFormEndpoint }}" method="POST">
      <label>Name <input name="name" autocomplete="name" required></label>
      <label>Phone <input name="phone" type="tel" autocomplete="tel"></label>
      <label>Email <input name="email" type="email" autocomplete="email" required></label>
      <label>What are you working on? <select name="project"><option>New build</option><option>Remodel</option><option>Replacing a fixture or two</option><option>Something else</option></select></label>
      <label>Anything we should know? <textarea name="message" rows="4"></textarea></label>
      <button class="btn btn-primary" type="submit">Request a consultation</button>
    </form>
    {%- else %}
    {% if block.text %}<div class="text-lg">{{ block.text | md | safe }}</div>{% endif %}
    <div class="cta-row">
      <a class="btn btn-primary" href="tel:{{ site.phoneE164 }}">Call {{ site.phone }}</a>
      <a class="btn btn-outline" href="/visit/">Directions &amp; hours</a>
    </div>
    {%- endif %}
  </div>
</section>
