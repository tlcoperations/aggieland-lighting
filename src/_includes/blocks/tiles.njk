{#- TILES — simple link boxes. eyebrow, title, text, columns, items[{title,text,href}], note -#}
<section class="section bg-{{ block.bg or 'plain' }}">
  <div class="container">
    {% include "blocks/_head.njk" %}
    <div class="grid grid-{{ block.columns or 4 }}">
      {%- for item in block.items %}
      <a class="tile" href="{{ (item.href or '{shop}') | fill }}"><strong>{{ item.title }}</strong><span>{{ item.text }}</span></a>
      {%- endfor %}
    </div>
    {% if block.note %}<div class="note">{{ block.note | md | safe }}</div>{% endif %}
  </div>
</section>
